{
  "name": "kutahya-taksi-agi",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "env:generate": "node scripts/generate-env.mjs",
    "prestart": "npm run env:generate",
    "start": "ng serve",
    "prebuild": "npm run env:generate",
    "build": "ng build",
    "postbuild": "node scripts/remove-csr-fallback.mjs",
    "watch": "ng build --watch --configuration development",
    "pretest": "npm run env:generate",
    "test": "ng test",
    "lint": "ng lint",
    "lint:fix": "ng lint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "serve:ssr": "node dist/kutahya-taksi-agi/server/server.mjs",
    "db:types": "supabase gen types typescript --linked --schema public > src/app/core/data/database.types.ts",
    "db:push": "supabase db push",
    "db:test-rls": "node --env-file=.env scripts/rls-test.mjs"
  },
  "private": true,
  "packageManager": "npm@11.17.0",
  "dependencies": {
    "@angular/common": "^22.0.0",
    "@angular/compiler": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "@angular/platform-browser": "^22.0.0",
    "@angular/platform-server": "^22.0.0",
    "@angular/router": "^22.0.0",
    "@angular/ssr": "^22.0.6",
    "@supabase/supabase-js": "^2.116.0",
    "express": "^5.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.0.6",
    "@angular/cli": "^22.0.6",
    "@angular/compiler-cli": "^22.0.0",
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.1",
    "@types/node": "^20.17.19",
    "angular-eslint": "^22.5.0",
    "eslint": "^10.10.0",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "supabase": "^2.117.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.70.0",
    "vitest": "^4.0.8"
  }
}
