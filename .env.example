# Kütahya Taksi Ağı — ortam değişkenleri
#
# Bu dosyayı `.env` olarak kopyalayın ve doldurun. `.env` git'e ASLA girmez.
# Vercel'de bu değişkenler proje ayarlarından (Settings > Environment Variables) tanımlanır.
#
#   cp .env.example .env

# --- Supabase (Faz 2'de doldurulacak) -------------------------------------
# Supabase Dashboard > Project Settings > API
SUPABASE_URL=
SUPABASE_ANON_KEY=

# DİKKAT: service_role anahtarı client bundle'a ASLA girmez.
# Yalnızca lokal migration/seed script'lerinde ve CI'da kullanılır.
# Bu satırı `.env` dosyanızda doldurun, burada boş bırakın.
SUPABASE_SERVICE_ROLE_KEY=

# --- Site --------------------------------------------------------------------
# Canonical URL, sitemap ve OpenGraph için taban adres. Sonunda "/" OLMADAN.
# Domain henüz alınmadı; production'da gerçek domain ile doldurulacak.
# Boş bırakılırsa development'ta http://localhost:4200 varsayılır.
SITE_URL=

# development | preview | production
ENVIRONMENT=development

# --- SSR ---------------------------------------------------------------------
# Angular SSR, SSRF koruması için istek hostname'ini doğrular. Vercel'de deployment
# domain'i buraya virgülle ayrılmış olarak yazılır (ör. kutahyataksi.com,www.kutahyataksi.com).
# Boş bırakılırsa yalnızca localhost'a izin verilir.
NG_ALLOWED_HOSTS=
